   40.0,
   180.0
  ],
  "estimator": "ppglib.hr_harmonic comb (0.6-3.4 Hz, 3 harmonics, low-band gate 1.1 Hz, cont_w=0.35), prev=None",
  "effective_fs_hz": 64.0,
  "native_fs_hz": {
   "ppg": 64,
   "acc_wrist": 32,
   "acc_chest": 700,
   "ecg": 700,
   "resp": 700,
   "eda": 4,
   "temp": 4,
   "activity": 4
  },
  "kisr_stft": "nperseg=64, hop=16 at 64 Hz (1-s frame, 75% overlap) - same time-frequency geometry as the Wrist native run (256/64 at 256 Hz) and the 64-Hz sizing config of run_wrist_expanded.py",
  "imu_resampling": "scipy.signal.resample_poly (zero-phase polyphase FIR, Kaiser beta=5) onto the 64-Hz PPG grid: wrist acc up=2/down=1 (32->64 Hz), chest acc up=16/down=175 (700->64 Hz); common t=0 start (synchronised distributed pickles), length ratios verified per subject",
  "activities": "dataset 4-Hz labels: walking=7, cycling=4, stairs=2 (running is NOT in the DaLiA protocol; stairs substituted as third vigorous activity); modal label per window with >=75% purity (transition windows excluded); sitting/soccer/driving/lunch/working/transient excluded",
  "channel_sets": "ch_acc = wrist ACC; ch_acc_chest = chest ACC; ch_acc_both = wrist+chest ACC union (reference). The public PPG-DaLiA release has NO gyroscope and NO magnetometer (readme III.1/III.2), so the requested gyro/mag ablations cannot be run without fabricating data; the inertial union law is tested with the two available accelerometers.",
  "continuity_prior": "prev=None for every channel set (as in run_wrist_expanded channel ablations)",
  "bootstrap": "subject-clustered, 4000 resamples, percentile 95% CI (common.cluster_bootstrap_ci / delta_summary)",
  "tost_margin_bpm": 2.0,
  "tost_alpha": 0.05
 },
